{
  "name": "teachai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13 <23",
    "npm": ">=10.9 <11"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests playwright.config.ts vitest.config.ts vitest.setup.ts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src/lib",
    "test:integration": "vitest run src/app",
    "test:e2e": "playwright test",
    "audit:prod": "npm audit --omit=dev --audit-level=critical",
    "setup:convex": "npx convex dev --once",
    "deploy:teachai": "npm run build && npx convex deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.56.0",
    "@clerk/nextjs": "6.39.6",
    "@google-cloud/local-auth": "^3.0.1",
    "@radix-ui/react-icons": "^1.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.48.0",
    "googleapis": "^154.0.0",
    "lucide-react": "^0.525.0",
    "next": "16.4.3",
    "openai": "^5.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^4.6.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "convex-test": "0.0.65",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.11"
  },
  "description": "A modern web application: teachai - built with Next.js,Convex,Clerk,TypeScript,Tailwind CSS",
  "packageManager": "npm@10.9.8"
}
